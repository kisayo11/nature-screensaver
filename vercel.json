{
  "version": 2,
  "outputDirectory": "admin-web",
  "headers": [
    {
      "source": "/config.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
